<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<!-- Part 5: File Integrity Monitoring (FIM) Custom Rule -->

<group name="windows, security, account_management">

  <rule id="100200" level="12">
    <if_sid>60109</if_sid>
    <field name="win.eventdata.targetUserName">^Guest$</field>
    
    <description>MYDFIR-Dele Windows Guest account was enabled.</description>
    
    <mitre>
      <id>T1078</id>
    </mitre>
    
    <group>
      windows,
      windows_security,
      account_changed,
      add_user,
      account_enabled,
      guest_account,
    </group>
  </rule>
  
</group>

<!-- Part 6: SSH Brute-Force Detection Custom Rule -->

<group name="local, syslog, sshd, authentication_failed">
  <rule id="100101" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip/>
    <description>Multiple SSH login failures observed from the same source IP</description>
    <mitre>
      <id>T1118</id>
    </mitre>
    <group>authentication_failed, ssh_bruteforce, credential_access,</group>
  </rule>
</group>